# Postgres (Neon or Vercel Postgres). Required for anything that persists.
# The app also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, DATABASE_URL_UNPOOLED
# and POSTGRES_URL_NON_POOLING, because the Vercel and Neon integrations set
# different names depending on how the database was attached. Attaching a
# database does NOT create the schema — run the migration afterwards.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional: a throwaway Postgres for the repository integration suite
# (npm run test:db). The suite skips entirely when this is unset.
TEST_DATABASE_URL=

# Upstash Redis. Optional — the cache falls back to an in-process LRU when unset,
# which is fine for local dev and wrong for serverless (each lambda gets its own).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic. Required for the Commissioner's Report and AAR narrative.
ANTHROPIC_API_KEY=
LEAGUEOPS_MODEL=claude-sonnet-4-5

# Clerk. Optional — auth is bypassed entirely when these are unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared secret for /api/cron/* routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Optional prop-line vendor for market-implied projections (see projections.source).
PROPS_VENDOR_API_KEY=
